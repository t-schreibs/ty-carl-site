<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/site.css">
    <title>{{ title }}</title>
  </head>
  <body>
    <main>
      <h1 style="margin-top: 20px;">{{ title }}</h1>
      <div class="card">
        {{ content | safe }}
        <div class="container reverse margin-top">
          <div class="circle gold"></div>
          <div class="circle blue"></div>
          <div class="circle wine"></div>
        </div>
      </div>
    </main>
  </body>
</html>
